# Saudi Pro League predictor - live data credentials
#
# Free key (100 requests/day) from https://dashboard.api-football.com/register
# Copy this file to .env and paste your key below.
API_FOOTBALL_KEY=

# "direct" for v3.football.api-sports.io (dashboard.api-football.com keys)
# "rapidapi" if your key came from RapidAPI
API_FOOTBALL_MODE=direct

# Safety ceiling on upstream calls per run, so a loop cannot burn the daily quota
API_FOOTBALL_BUDGET=95
